#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors/rgbled_widget.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Layer Numbering

#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUN     3
#define MOUSE   4
#define SCROLL  5

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        scroll {
            bindings = <&mo 5>;
            key-positions = <49 50>;
        };
    };

    behaviors {
        sensor_rotate_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_wheel_scroll: mouse_wheel_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "DEFAULT";
            bindings = <
&kp ESC           &kp N1  &kp N2            &kp N3  &kp N4  &kp N5                                                 &kp N6                    &kp N7  &kp N8     &kp N9   &kp N0    &kp BSPC
&kp TAB           &kp Q   &kp W             &kp E   &kp R   &kp T                    &trans           &trans       &kp Y                     &kp U   &kp I      &kp O    &kp P     &kp RET
&kp LEFT_CONTROL  &kp A   &kp S             &kp D   &kp F   &kp G                    &mo 5            &mo 3        &kp H                     &kp J   &kp K      &kp L    &mkp MB1  &mkp MB2
&kp LEFT_SHIFT    &kp Z   &kp X             &kp C   &kp V   &kp B                    &lt 3 SEMICOLON  &lt 2 MINUS  &kp N                     &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
&kp LEFT_ALT      &mo 1   &kp LEFT_CONTROL  &mo 5   &mo 3   &mt LEFT_GUI LANGUAGE_2  &lt 1 SPACE      &lt 6 SPACE  &mt RIGHT_GUI LANGUAGE_1                              &mo 3     &mo 5
            >;

            sensor-bindings = <&mouse_wheel_scroll SCRL_UP SCRL_DOWN>;
        };

        number_layer {
            label = "NUM";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                     &trans  &trans  &kp MINUS  &kp EQUAL         &kp INTERNATIONAL_3  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans     &kp LEFT_BRACKET  &kp RIGHT_BRACKET    &trans
&trans  &kp A   &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &kp SEMI   &kp APOS          &kp BACKSLASH        &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp UNDER  &trans  &trans  &trans     &trans            &kp LS(0x87)         &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans                                       &trans               &trans
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans                  &trans                   &trans  &trans              &trans            &trans
&trans  &trans        &trans        &trans        &trans        &bt BT_CLR    &trans    &trans  &kp LG(LEFT_ARROW)      &kp LG(RIGHT)            &trans  &trans              &trans            &trans
&trans  &trans        &trans        &trans        &trans        &trans        &ind_con  &trans  &kp LC(LEFT_ARROW)      &kp LC(RIGHT_ARROW)      &trans  &kp LC(LEFT_ARROW)  &kp LC(UP_ARROW)  &kp LC(RIGHT_ARROW)
&trans  &trans        &trans        &trans        &trans        &trans        &ind_bat  &trans  &kp LG(LA(LEFT_ARROW))  &kp LG(LA(RIGHT_ARROW))  &trans  &trans              &trans            &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans    &trans  &trans                                                                       &trans            &trans
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&kp C_BRIGHTNESS_DEC  &kp C_BRI_INC  &kp F2             &kp F3             &kp F4             &kp F5                                &kp K_PREVIOUS  &kp K_PLAY_PAUSE  &kp K_NEXT  &kp K_MUTE          &kp C_VOLUME_DOWN       &kp C_VOLUME_UP
&trans                &trans         &trans             &kp LG(LEFT)       &kp LG(RIGHT)      &trans     &trans             &trans  &trans          &trans            &trans      &trans              &kp LA(LG(LEFT_ARROW))  &kp LA(LG(RIGHT_ARROW))
&trans                &trans         &trans             &kp LG(LA(LEFT))   &kp LG(LA(RIGHT))  &trans     &kp C_VOLUME_UP    &trans  &trans          &trans            &trans      &kp LC(LEFT_ARROW)  &kp LC(UP_ARROW)        &kp LC(RIGHT_ARROW)
&trans                &trans         &kp LG(LC(COMMA))  &kp LG(LC(LA(M)))  &kp LG(LC(SLASH))  &trans     &kp C_VOLUME_DOWN  &trans  &trans          &trans            &trans      &kp LG(LC(COMMA))   &kp LG(LA(LC(M)))       &kp LG(LC(SLASH))
&trans                &trans         &trans             &trans             &trans             &mkp RCLK  &trans             &trans  &trans                                                            &kp LG(LEFT_ARROW)      &kp LG(RIGHT_ARROW)
            >;

            sensor-bindings = <&sensor_rotate_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans             &kp LG(LEFT_ARROW)      &kp LG(RIGHT_ARROW)
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans             &kp LG(LA(LEFT_ARROW))  &kp LG(LA(RIGHT_ARROW))
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LC(UP_ARROW)   &kp LC(LEFT_ARROW)      &kp LC(RIGHT_ARROW)
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LG(LC(LA(M)))  &kp LG(LC(COMMA))       &kp LG(LC(SLASH))
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                                     &trans                  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans   &trans   &trans                   &trans          &trans          &trans           &trans  &trans  &trans
&trans  &trans  &trans  &trans   &trans   &trans   &trans  &trans  &trans          &trans          &trans           &trans  &trans  &trans
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6   &trans  &trans  &trans          &kp UP_ARROW    &trans           &trans  &trans  &trans
&kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans  &trans
&trans  &trans  &trans  &trans   &trans   &trans   &trans  &trans  &trans                                                   &trans  &trans
            >;
        };
    };
};
